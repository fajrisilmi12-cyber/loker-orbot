{
  "manifest_version": 3,
  "name": "CV Blaster Companion",
  "version": "1.0.0",
  "description": "Companion Extension for CV Blaster - 1-Click Cookie Sync & Job Portal Session Connector",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glints.com/*",
    "*://*.jobstreet.co.id/*",
    "*://*.jobstreet.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CV Blaster Sync"
  }
}
