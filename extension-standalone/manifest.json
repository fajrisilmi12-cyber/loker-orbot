{
  "manifest_version": 3,
  "name": "lemparjaring Standalone",
  "version": "1.0.0",
  "description": "Ekstensi pelamar kerja otomatis mandiri (serverless) - Lamar puluhan lowongan Indeed, LinkedIn, Glints & JobStreet langsung dari peramban Anda.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glints.com/*",
    "*://*.jobstreet.co.id/*",
    "*://*.jobstreet.com/*",
    "*://boards.greenhouse.io/*",
    "*://job-boards.greenhouse.io/*",
    "*://jobs.lever.co/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "lemparjaring"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content_scripts/linkedin_talent.js",
        "content_scripts/floating_assistant.js"
      ],
      "css": [
        "content_scripts/floating_assistant.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.id.indeed.com/*"
      ],
      "js": [
        "content_scripts/indeed_apply.js",
        "content_scripts/floating_assistant.js"
      ],
      "css": [
        "content_scripts/floating_assistant.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.jobstreet.co.id/*",
        "*://*.jobstreet.com/*"
      ],
      "js": [
        "content_scripts/floating_assistant.js"
      ],
      "css": [
        "content_scripts/floating_assistant.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.glints.com/*"
      ],
      "js": [
        "content_scripts/floating_assistant.js"
      ],
      "css": [
        "content_scripts/floating_assistant.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://jobs.lever.co/*"
      ],
      "js": [
        "content_scripts/ats_adapter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content_scripts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
